{
  "name": "@meetsanctum/mcp",
  "version": "0.1.0",
  "description": "Connects an AI agent on a computer at home to Sanctum over MCP",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "sanctum-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/cli.js",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/cli.ts src/index.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --external:@modelcontextprotocol/client --external:@modelcontextprotocol/server --external:@napi-rs/keyring --external:bonjour-service",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@napi-rs/keyring": "2.1.2",
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "@meetsanctum/auth-protocol": "workspace:*",
    "@meetsanctum/typescript-config": "workspace:*",
    "@peculiar/x509": "2.2.0",
    "esbuild": "0.28.2",
    "reflect-metadata": "0.2.2",
    "vitest": "^4.1.5"
  }
}
