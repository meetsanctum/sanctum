{
  "name": "@meetsanctum/ui-sdk",
  "version": "0.1.12",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "sanctum-pages": "./bin/sanctum-pages.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.tools.json && node bin/sanctum-pages.js kit",
    "lint": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json --noEmit",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "api": "node bin/sanctum-pages.js api",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "eslint-scope": "^9.1.2",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@meetsanctum/app-sdk": "workspace:*",
    "@meetsanctum/typescript-config": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  }
}
