{
  "id": "sanctum.fake-lights",
  "name": "Fake lights",
  "version": "0.1.0",
  "core": "^2.0.0",
  "protocol": 11,
  "summary": null,
  "runtime": {
    "memory": 128,
    "data": 256
  },
  "migrations": null,
  "driver": {
    "hooks": [
      "command",
      "pairing",
      "identify",
      "add"
    ],
    "questions": {
      "key": {
        "label": "Key",
        "kind": "secret",
        "help": "Whoever set the plug up has it.",
        "refusals": {
          "wrongKey": "That key doesn't match. Check it and try again."
        }
      }
    }
  },
  "permissions": [
    {
      "id": "devices.register",
      "reason": "To bring pretend lights, sensors and a plug into a development home.",
      "needed": true,
      "asked": null,
      "startsOn": false
    }
  ],
  "icon": null,
  "pages": [],
  "settings": null,
  "actions": [],
  "events": [],
  "provides": {
    "entities": [],
    "widgets": [],
    "roomSections": [],
    "devicePages": [],
    "triggers": [],
    "conditions": [],
    "steps": []
  }
}
