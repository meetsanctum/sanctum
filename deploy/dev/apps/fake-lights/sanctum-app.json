{
  "id": "sanctum.fake-lights",
  "name": "Fake lights",
  "version": "0.1.0",
  "core": "^2.0.0",
  "protocol": 29,
  "summary": null,
  "runtime": {
    "memory": 128,
    "data": 256
  },
  "migrations": null,
  "driver": {
    "hooks": [
      "command",
      "pairing",
      "identify",
      "repair",
      "add",
      "cancelAdd",
      "cancelRepair"
    ],
    "problems": {
      "pairingLost": {
        "words": "Its pairing was removed",
        "repair": {
          "help": "Pair it again. The TV shows two codes, one after the other.",
          "asks": [],
          "later": [
            "firstCode",
            "secondCode"
          ]
        }
      }
    },
    "questions": {
      "key": {
        "label": "Key",
        "kind": "secret",
        "help": "Whoever set the plug up has it.",
        "refusals": {
          "wrongKey": "That key doesn't match. Check it and try again."
        }
      },
      "firstCode": {
        "label": "Code on the TV (1 of 2)",
        "kind": "code",
        "length": 4,
        "help": "The TV shows a four-digit code. Any but 0000 works here.",
        "refusals": {
          "wrongCode": "That code didn't match."
        }
      },
      "secondCode": {
        "label": "Code on the TV (2 of 2)",
        "kind": "code",
        "length": 4,
        "help": "A new code is on the TV.",
        "lasts": {
          "seconds": 35,
          "again": "Show a new code"
        },
        "refusals": {
          "wrongCode": "That code didn't match."
        }
      }
    },
    "addLater": [
      "firstCode",
      "secondCode"
    ]
  },
  "permissions": [
    {
      "id": "devices.register",
      "reason": "To bring pretend lights, sensors and a plug into a development home.",
      "needed": true,
      "asked": null,
      "startsOn": false
    }
  ],
  "icon": null,
  "pages": [],
  "settings": null,
  "actions": [],
  "events": [],
  "provides": {
    "entities": [],
    "widgets": [],
    "roomSections": [],
    "devicePages": [],
    "triggers": [],
    "conditions": [],
    "steps": []
  }
}
