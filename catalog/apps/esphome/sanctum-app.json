{
  "id": "sanctum.esphome",
  "name": "ESPHome",
  "version": "0.7.0",
  "core": "^2.0.0",
  "protocol": 14,
  "summary": "Brings your ESPHome lights, plugs, sensors, buttons and speakers into your home.",
  "runtime": {
    "memory": 128,
    "data": 256
  },
  "migrations": "migrations",
  "driver": {
    "hooks": [
      "command",
      "remove",
      "identify",
      "repair",
      "discovered",
      "add"
    ],
    "problems": {
      "keyMismatch": {
        "words": "Its encryption key doesn't match",
        "repair": {
          "help": "Its key changed, as when it's flashed with a new configuration. Enter the key from that configuration, under api: encryption: key.",
          "asks": [
            "key"
          ]
        }
      },
      "keyAdded": {
        "words": "It has an encryption key now",
        "repair": {
          "help": "It was flashed with a configuration that has one. Enter the key from that configuration, under api: encryption: key.",
          "asks": [
            "key"
          ]
        }
      },
      "notEncrypted": {
        "words": "It isn't encrypted",
        "repair": {
          "help": "Give it a setup key without encryption, then its own key encrypted.",
          "asks": []
        }
      },
      "keyLost": {
        "words": "It lost its key, as when it's reset",
        "repair": {
          "help": "Give it a new key, as when it was added.",
          "asks": []
        }
      }
    },
    "questions": {
      "key": {
        "label": "Encryption key",
        "kind": "secret",
        "help": "From its configuration, under api: encryption: key.",
        "refusals": {
          "wrongKey": "That key doesn't match. Copy it again from its configuration, under api: encryption: key."
        }
      }
    },
    "refusals": {
      "notWaiting": "It stopped waiting for a key. Turn it off and on again, then add it.",
      "keyChanged": "It has another key now. Add it again with the key from its configuration, under api: encryption: key.",
      "hasKey": "It has an encryption key already. Enter it, or remove it from the app that gave it one, then add it here.",
      "changed": "It answered differently from before. Check what it says now, then add it."
    }
  },
  "permissions": [
    {
      "id": "devices.register",
      "reason": "To add your ESPHome devices and keep their state.",
      "needed": true,
      "asked": null,
      "startsOn": false
    },
    {
      "id": "discover:mdns:_esphomelib._tcp",
      "reason": "To find your ESPHome devices.",
      "needed": true,
      "asked": null,
      "startsOn": false
    },
    {
      "id": "lan:tcp:6053",
      "reason": "To talk to the ESPHome devices it found.",
      "needed": true,
      "asked": null,
      "startsOn": false
    }
  ],
  "icon": {
    "glyph": "cpu",
    "color": "graphite"
  },
  "pages": [],
  "settings": null,
  "actions": [
    {
      "id": "esphome.device",
      "title": "Device",
      "tier": "read",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "device": {
            "type": "string"
          }
        },
        "required": [
          "device"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "encrypted": {
            "type": "boolean"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "signal": {
            "type": [
              "number",
              "null"
            ]
          },
          "unused": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sleeps": {
            "type": "boolean"
          },
          "firstKey": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "setup"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "heardWakeWordAt": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "address",
          "encrypted",
          "version",
          "signal",
          "unused",
          "sleeps",
          "firstKey",
          "heardWakeWordAt"
        ],
        "additionalProperties": false
      },
      "assistant": null
    },
    {
      "id": "esphome.speaker",
      "title": "Smart speaker",
      "tier": "read",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "device": {
            "type": "string"
          }
        },
        "required": [
          "device"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "microphones": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "ring": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "glow": {
                    "type": "boolean"
                  },
                  "colour": {
                    "type": "string",
                    "pattern": "^#[0-9a-f]{6}$"
                  },
                  "brightness": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "glow",
                  "colour",
                  "brightness"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "heardWakeWordAt": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "microphones",
          "ring",
          "heardWakeWordAt"
        ],
        "additionalProperties": false
      },
      "assistant": null
    },
    {
      "id": "esphome.changeSpeaker",
      "title": "Change a smart speaker",
      "tier": "write",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "device": {
            "type": "string"
          },
          "microphones": {
            "type": "boolean"
          },
          "ring": {
            "type": "object",
            "properties": {
              "glow": {
                "type": "boolean"
              },
              "colour": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              "brightness": {
                "type": "integer",
                "minimum": 20,
                "maximum": 100
              }
            }
          }
        },
        "required": [
          "device"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "assistant": null
    }
  ],
  "events": [],
  "provides": {
    "entities": [],
    "widgets": [],
    "roomSections": [],
    "devicePages": [
      {
        "id": "esphome.device",
        "title": "ESPHome",
        "kinds": [],
        "devices": "own"
      }
    ],
    "triggers": [],
    "conditions": [],
    "steps": []
  }
}
