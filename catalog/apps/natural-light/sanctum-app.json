  "icon": {
    "glyph": "sun",
    "color": "sun"
  },
  "pages": [
    "main"
  ],
  "settings": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "on": {
        "default": true,
        "title": "Natural Light",
        "description": "Lights that follow it change with the day. Off, each keeps the look it has.",
        "type": "boolean"
      },
      "shape": {
        "default": "balanced",
        "title": "Curve",
        "description": "When the curve peaks: at solar noon, or a third of the way into the day.",
        "options": {
          "balanced": "Balanced",
          "early_riser": "Early riser"
        },
        "type": "string",
        "enum": [
          "balanced",
          "early_riser"
        ]
      },
      "lowKelvin": {
        "default": 2000,
        "title": "Colour temperature at night",
        "description": "In kelvin, from sunset to sunrise. Lower is warmer.",
        "type": "integer",
        "minimum": 2000,
        "maximum": 6500,
        "multipleOf": 100
      },
      "highKelvin": {
        "default": 5500,
        "title": "Colour temperature at the peak",
        "description": "In kelvin. Higher is cooler.",
        "type": "integer",
        "minimum": 2000,
        "maximum": 6500,
        "multipleOf": 100
      },
      "lowBrightness": {
        "default": 80,
        "title": "Brightness at night",
        "description": "In percent, from sunset to sunrise.",
        "type": "integer",
        "minimum": 20,
        "maximum": 100,
        "multipleOf": 5
      },
      "highBrightness": {
        "default": 100,
        "title": "Brightness at the peak",
        "description": "In percent.",
        "type": "integer",
        "minimum": 20,
        "maximum": 100,
        "multipleOf": 5
      },
      "sunriseOffsetMinutes": {
        "default": 0,
        "title": "Minutes after sunrise",
        "description": "When the curve starts towards its peak; a negative number starts it before sunrise.",
        "type": "integer",
        "minimum": -120,
        "maximum": 120,
        "multipleOf": 15
      },
      "sunsetOffsetMinutes": {
        "default": 0,
        "title": "Minutes after sunset",
        "description": "When the curve is back at night; a negative number ends it before sunset.",
        "type": "integer",
        "minimum": -120,
        "maximum": 120,
        "multipleOf": 15
      }
    }
  },
