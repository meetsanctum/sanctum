{
  "id": "sanctum.natural-light",
  "name": "Natural Light",
  "version": "0.4.1",
  "core": "^2.0.0",
  "protocol": 14,
  "summary": "Lights that follow the colour of daylight through the day.",
  "runtime": {
    "memory": 128,
    "data": 256
  },
  "migrations": "migrations",
  "driver": null,
  "permissions": [
    {
      "id": "places.location",
      "reason": "To follow the sun where your home is.",
      "needed": true,
      "asked": null,
      "startsOn": false
    },
    {
      "id": "devices.control:light",
      "reason": "To bring the lights that follow it to the light of the day.",
      "needed": true,
      "asked": null,
      "startsOn": false
    },
    {
      "id": "places.read",
      "reason": "To list your lights by room.",
      "needed": false,
      "asked": null,
      "startsOn": true
    }
