{
  "id": "sanctum.natural-light",
  "name": "Natural light",
  "version": "0.1.0",
  "core": "^1.0.0",
  "summary": "Lights that follow the colour of daylight through the day.",
  "runtime": {
    "memory": 128,
    "data": 256
  },
  "migrations": "migrations",
  "driver": null,
  "permissions": [
    {
      "id": "places.location",
      "reason": "To follow the sun where your home is.",
      "needed": true,
      "asked": null,
      "startsOn": false
    },
    {
      "id": "devices.control:light",
      "reason": "To bring the lights that follow it to the light of the day.",
      "needed": true,
      "asked": null,
      "startsOn": false
    }
  ],
  "icon": {
    "glyph": "sun",
    "color": "sun"
  },
  "pages": [
    "main"
  ],
  "settings": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "shape": {
        "default": "balanced",
        "title": "Curve",
        "description": "When the curve peaks: at solar noon, or a third of the way into the day.",
        "options": {
          "balanced": "Balanced",
          "early_riser": "Early riser"
        },
        "type": "string",
        "enum": [
          "balanced",
          "early_riser"
        ]
      },
      "lowKelvin": {
        "default": 2000,
        "title": "Colour temperature at night",
        "description": "In kelvin, from sunset to sunrise. Lower is warmer.",
        "type": "integer",
        "minimum": 2000,
        "maximum": 6500,
        "multipleOf": 100
      },
      "highKelvin": {
        "default": 5500,
        "title": "Colour temperature at the peak",
        "description": "In kelvin. Higher is cooler.",
        "type": "integer",
        "minimum": 2000,
        "maximum": 6500,
        "multipleOf": 100
      },
      "lowBrightness": {
        "default": 80,
        "title": "Brightness at night",
        "description": "In percent, from sunset to sunrise.",
        "type": "integer",
        "minimum": 20,
        "maximum": 100,
        "multipleOf": 5
      },
      "highBrightness": {
        "default": 100,
        "title": "Brightness at the peak",
        "description": "In percent.",
        "type": "integer",
        "minimum": 20,
        "maximum": 100,
        "multipleOf": 5
      },
      "sunriseOffsetMinutes": {
        "default": 0,
        "title": "Minutes after sunrise",
        "description": "When the curve starts towards its peak; a negative number starts it before sunrise.",
        "type": "integer",
        "minimum": -120,
        "maximum": 120,
        "multipleOf": 15
      },
      "sunsetOffsetMinutes": {
        "default": 0,
        "title": "Minutes after sunset",
        "description": "When the curve is back at night; a negative number ends it before sunset.",
        "type": "integer",
        "minimum": -120,
        "maximum": 120,
        "multipleOf": 15
      }
    }
  },
