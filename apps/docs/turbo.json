{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/client/src/brand.ts",
        "$TURBO_ROOT$/assets/brand/sanctum-favicon.svg",
        "$TURBO_ROOT$/assets/brand/sanctum-logo.svg",
        "$TURBO_ROOT$/assets/brand/sanctum-logo-white.svg",
        "$TURBO_ROOT$/assets/brand/readme-home.jpg"
      ],
      "outputs": ["dist/**"],
      "env": ["DOCS_URL"],
      "passThroughEnv": ["ASTRO_TELEMETRY_DISABLED"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/client/src/brand.ts"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/client/src/brand.ts"]
    }
  }
}
