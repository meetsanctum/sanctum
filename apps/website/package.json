{
  "name": "@meetsanctum/website",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenvx run --strict --quiet --ignore=MISSING_ENV_FILE -- next dev --port 5174",
    "build": "next build",
    "start": "dotenvx run --strict --quiet --ignore=MISSING_ENV_FILE -f .env.production -- next start",
    "lint": "next typegen && tsc -p tsconfig.json",
    "typecheck": "next typegen && tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.38.2",
    "@fontsource/inter": "5.3.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "6.38.0"
  },
  "devDependencies": {
    "@meetsanctum/brand": "workspace:*",
    "@meetsanctum/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vitest": "^4.1.5"
  }
}
