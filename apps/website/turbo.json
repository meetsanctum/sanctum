{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/client/src/brand.ts",
        "$TURBO_ROOT$/assets/brand/sanctum-favicon.svg",
        "$TURBO_ROOT$/assets/brand/sanctum-logo-white.png",
        "$TURBO_ROOT$/assets/brand/photos/living-room-plant.jpg",
        "$TURBO_ROOT$/assets/brand/app-home-window.webp"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": ["SITE_URL"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/client/src/brand.ts"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/client/src/brand.ts"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production",
        "$TURBO_ROOT$/.dockerignore",
        "$TURBO_ROOT$/apps/client/src/brand.ts"
      ]
    }
  }
}
