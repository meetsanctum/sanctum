# What the website reads. Keep the real values with dotenvx, which encrypts
# them as it writes them:
#
#   pnpm exec dotenvx set RESEND_API_KEY <key>                      for pnpm dev (.env)
#   pnpm exec dotenvx set RESEND_API_KEY <key> -f .env.production   for the published site

# Resend's API key, with access to contacts and to sending. The waitlist
# answers "not set up" without it.
RESEND_API_KEY=

# Who the confirmation is from, at a domain verified with Resend.
WAITLIST_FROM="Sanctum <hello@example.com>"

# The segment of Resend's contacts that joins belong to. Optional: without
# it they are contacts in no segment.
RESEND_SEGMENT_ID=

# Where the site is published, if not at https://meetsanctum.com. Read when
# the site is built as well, so on Railway it is a variable in plain text
# rather than a line in .env.production.
SITE_URL=
